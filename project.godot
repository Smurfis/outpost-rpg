; Outpost | Godot 4.7.x | Android landscape
config_version=5

[application]
config/name="Outpost"
run/main_scene="res://scenes/ui/company_splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Original isometric fantasy crafting RPG prototype"
; Show the Five Star Interactive scene first; suppress Godot’s built-in boot logo.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.039, 0.049, 0.096, 1)
config/version="0.5.0-dev"
config/android_build_code=11
config/icon="res://assets/branding/outpost_launcher_approved.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=18.0

[editor_plugins]
enabled=PackedStringArray("res://addons/bbmodel-importer/plugin.cfg")
