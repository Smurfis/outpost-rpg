; Outpost | Godot 4.7.x | Android landscape
config_version=5

[application]
config/name="Outpost"
run/main_scene="res://scenes/ui/company_splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Original isometric fantasy crafting RPG prototype"
config/version="0.5.0-dev"
config/icon="res://assets/branding/outpost_icon_foreground.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=18.0
